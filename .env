# Runtime
RUST_BACKTRACE=1
NODE_NO_WARNINGS=1

# Brew
HOMEBREW_NO_ENV_HINTS=1
HOMEBREW_CLEANUP_MAX_AGE_DAYS=0

# OpenCode
OPENCODE_DISABLE_CLAUDE_CODE=1

# Cmux
CMUX_AMP_HOOKS_DISABLED=1
CMUX_ANTIGRAVITY_HOOKS_DISABLED=1
CMUX_CAMPFIRE_HOOKS_DISABLED=1
CMUX_CLAUDE_HOOKS_DISABLED=1
CMUX_CODEBUDDY_HOOKS_DISABLED=1
CMUX_CODEX_HOOKS_DISABLED=1
CMUX_COPILOT_HOOKS_DISABLED=1
CMUX_CURSOR_HOOKS_DISABLED=1
CMUX_FACTORY_HOOKS_DISABLED=1
CMUX_GEMINI_HOOKS_DISABLED=1
CMUX_GROK_HOOKS_DISABLED=1
CMUX_HERMES_AGENT_HOOKS_DISABLED=1
CMUX_KIMI_HOOKS_DISABLED=1
CMUX_KIRO_HOOKS_DISABLED=1
CMUX_OMP_HOOKS_DISABLED=1
CMUX_OPENCODE_HOOKS_DISABLED=1
CMUX_PI_HOOKS_DISABLED=1
CMUX_QODER_HOOKS_DISABLED=1
