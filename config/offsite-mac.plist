<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.sayad.offsite</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sayad/.local/bin/mise</string>
    <string>exec</string>
    <string>--</string>
    <string>offsite</string>
    <string>web</string>
    <string>--pwa</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>10101</string>
    <string>--no-auth</string>
    <string>--connect</string>
    <string>http://127.0.0.1:47841,https://of.sayad.cc</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sayad</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/sayad/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/sayad/Library/Logs/offsite.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sayad/Library/Logs/offsite.log</string>
</dict>
</plist>
