[Unit]
Description=offsite Claude Code web UI
After=network.target

[Service]
User=sayad
WorkingDirectory=/home/sayad
Environment=HOME=/home/sayad
ExecStart=/home/sayad/.local/bin/mise exec -- offsite serve --no-pair --host 127.0.0.1 --port 20201
KillSignal=SIGINT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
