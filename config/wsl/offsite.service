[Unit]
Description=offsite Claude Code web UI
After=network.target

[Service]
User=sayad
WorkingDirectory=/home/sayad
Environment=HOME=/home/sayad
ExecStart=/bin/bash -lc 'exec mise exec -- offsite serve --no-pair --host 0.0.0.0 --port 20201'
KillSignal=SIGINT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
