[
  // Shell
  {
    "Source": "@/config/shell/profile.sh",
    "Target.Mac": "~/.bash_profile"
  },
  {
    "Source": "@/config/shell/bashrc.sh",
    "Target": "~/.bashrc"
  },
  {
    "Source": "@/config/shell/fishrc.fish",
    "Target": "~/.config/fish/config.fish"
  },
  {
    "Source": "@/config/shell/pwshrc.ps1",
    "Target.Win": "~/Documents/PowerShell/profile.ps1"
  },

  // AGENTS.md
  {
    "Source": "~/.agents/skills/AGENTS_GLOBAL.md",
    "Target": [
      "~/.codex/AGENTS.md",
      "~/.gemini/GEMINI.md",
      "~/.config/opencode/AGENTS.md"
    ]
  },

  // Agents Skills
  {
    "Source": "~/.agents/skills",
    "Target": [
      "~/.claude/skills",
      "~/.claude-uig/skills",
      "~/.claude-work/skills",
      "~/.gemini/antigravity-cli/skills"
    ]
  },

  // Codex
  {
    "Source": "@/config/ai/codex.toml",
    "Target": "~/.codex/config.toml",
    "Copy": true
  },
  {
    "Source": "~/.codex/config.toml",
    "Target": "~/.codex-sayad/config.toml"
  },

  // Claude
  {
    "Source": "~/.agents/skills/AGENTS_CLAUDE.md",
    "Target": [
      "~/.claude/CLAUDE.md",
      "~/.claude-uig/CLAUDE.md",
      "~/.claude-work/CLAUDE.md"
    ]
  },
  {
    "Source": "@/config/ai/claude.json",
    "Target": [
      "~/.claude/settings.json",
      "~/.claude-uig/settings.json",
      "~/.claude-work/settings.json"
    ]
  },
  {
    "Source": "~/.claude/plans",
    "Target": ["~/.claude-uig/plans", "~/.claude-work/plans"]
  },
  {
    "Source": "~/.claude/tasks",
    "Target": ["~/.claude-uig/tasks", "~/.claude-work/tasks"]
  },
  {
    "Source": "~/.claude/plugins",
    "Target": ["~/.claude-uig/plugins", "~/.claude-work/plugins"]
  },
  {
    "Source": "~/.claude/projects",
    "Target": ["~/.claude-uig/projects", "~/.claude-work/projects"]
  },
  {
    "Source": "~/.claude/sessions",
    "Target": ["~/.claude-uig/sessions", "~/.claude-work/sessions"]
  },
  {
    "Source": "~/.claude/session-env",
    "Target": ["~/.claude-uig/session-env", "~/.claude-work/session-env"]
  },
  {
    "Source": "~/.claude/shell-snapshots",
    "Target": [
      "~/.claude-uig/shell-snapshots",
      "~/.claude-work/shell-snapshots"
    ]
  },
  {
    "Source": "~/.claude/history.jsonl",
    "Target": ["~/.claude-uig/history.jsonl", "~/.claude-work/history.jsonl"]
  },

  // Opencode
  {
    "Source": "@/config/ai/opencode.json",
    "Target": "~/.config/opencode/config.json"
  },
  {
    "Source": "@/config/ai/opencode-tui.json",
    "Target": "~/.config/opencode/tui.json"
  },
  {
    "Source": "@/config/ai/agents",
    "Target": "~/.config/opencode/agents"
  },
  {
    "Source": "@/config/ai/opencode/themes",
    "Target": "~/.config/opencode/themes"
  },
  {
    "Source": "@/config/ai/opencode/plugins",
    "Target": "~/.config/opencode/plugins"
  },
  {
    "Source": "@/config/ai/opencode/armor.json",
    "Target": "~/.opencode-armor.json"
  },
  {
    "Source": "@/config/ai/opencode/desktop.dat",
    "Target.Win": "$APPDATA/ai.opencode.desktop/default.dat",
    "Target.Mac": "~/Library/Application Support/ai.opencode.desktop/default.dat",
    "Copy": true
  },
  {
    "Source": "@/.local/opencode-auth.json",
    "Target": "~/.local/share/opencode/auth.json"
  },

  // PI
  {
    "Source": "@/config/ai/pi.json",
    "Target": "~/.pi/agent/settings.json",
    "Copy": true
  },

  // Terminal
  {
    "Source": "@/config/shell/alias.json",
    "Target": "~/.config/shaka.json"
  },
  {
    "Source": "@/config/shell/starship.toml",
    "Target": "~/.config/starship.toml"
  },
  {
    "Source": "@/config/shell/direnv.toml",
    "Target": "~/.config/direnv/direnv.toml"
  },
  {
    "Source": "@/config/mise-config.toml",
    "Target": "~/.config/mise/config.toml"
  },
  {
    "Source": "@/config/shell/fastfetch-win.jsonc",
    "Target.Win": "~/.config/fastfetch/config.jsonc"
  },
  {
    "Source": "@/config/shell/fastfetch-mac.jsonc",
    "Target.Mac": "~/.config/fastfetch/config.jsonc"
  },
  {
    "Source": "@/config/shell/btop.conf",
    "Target": "~/.config/btop/btop.conf"
  },
  {
    "Source": "@/config/shell/lsd-config.yaml",
    "Target": "~/.config/lsd/config.yaml"
  },

  // Terminal Emulators
  {
    "Source": "@/config/shell/ghostty.conf",
    "Target.Mac": "~/.config/ghostty/config"
  },
  {
    "Source": "@/config/shell/cmux.json",
    "Target.Mac": "~/.config/cmux/cmux.json",
    "Copy": true
  },
  {
    "Source": "@/config/windows-terminal.json",
    "Target.Win": "$LOCALAPPDATA/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
  },

  // OBS
  {
    "Source": "@/config/obs/basic-win",
    "Target.Win": "$APPDATA/obs-studio/basic",
    "Copy": true
  },
  {
    "Source": "@/config/obs/user-win.ini",
    "Target.Win": "$APPDATA/obs-studio/user.ini"
  },
  {
    "Source": "@/config/obs/basic-mac",
    "Target.Mac": "~/Library/Application Support/obs-studio/basic",
    "Copy": true
  },
  {
    "Source": "@/config/obs/user-mac.ini",
    "Target.Mac": "~/Library/Application Support/obs-studio/user.ini"
  },

  // Git
  {
    "Source": "@/config/global.gitignore",
    "Target": "~/.gitignore"
  },
  {
    "Source": "@/config/monogit.json",
    "Target.Win": "$APPDATA/monogit/config.json",
    "Target.Mac": "~/Library/Application Support/monogit/config.json",
    "Copy": true
  },

  // Other
  {
    "Source": "@/config/pnpm.yaml",
    "Target.Win": "$LOCALAPPDATA/pnpm/config.yaml",
    "Target.Mac": "~/Library/Preferences/pnpm/config.yaml"
  },
  {
    "Source": "@/config/colima.yaml",
    "Target.Mac": "~/.colima/default/colima.yaml",
    "Copy": true
  },
  {
    "Source": "@/config/oiper.json",
    "Target.Win": "$APPDATA/com.oiper.desktop/config.json",
    "Target.Mac": "~/Library/Application Support/com.oiper.desktop/config.json"
  },
  {
    "Source": "@/config/ai/codex-pets",
    "Target": "~/.codex/pets"
  },
  {
    "Source": "@/config/uni-run.json",
    "Target": "~/.uni-run.json"
  },
  {
    "Source": "@/config/ai/mysubs.json",
    "Target": "~/.config/mysubs/config.json"
  },
  {
    "Source": "@/config/ai/mytokens-group.json",
    "Target": "~/.mytokens/groups.json"
  },
  {
    "Source": "@/config/gityo.json",
    "Target": "~/.config/gityo.json"
  },
  {
    "Source": "@/config/nirc",
    "Target": "~/.nirc"
  },

  // System
  {
    "Copy": true,
    "Source": "@/config/US Simplified.keylayout",
    "Target.Mac": "~/Library/Keyboard Layouts/US Simplified.keylayout"
  },
  {
    "Copy": true,
    "Source": "@/config/karabiner.json",
    "Target.Mac": "~/.config/karabiner/karabiner.json"
  },
  {
    "Source": "@/config/Windhawk.json",
    "Target.Win": "$PROGRAMDATA/Windhawk/userprofile.json"
  },

  // Private
  {
    "Source": "$SYSTEM_FILE_DIR/AIMP",
    "Target.Win": "$APPDATA/AIMP"
  },
  {
    "Source": "$SYSTEM_FILE_DIR/WinRar.ini",
    "Target.Win": "~/scoop/apps/winrar/current/WinRar.ini"
  },
  {
    "Source": "$SYSTEM_FILE_DIR/qBittorrent.ini",
    "Target.Win": "$APPDATA/qBittorrent/qBittorrent.ini",
    "Copy": true
  },

  // Code Editor
  {
    "Source": "@/config/vscode/snippets",
    "Target.Win": [
      "$APPDATA/Code/User/snippets",
      "$APPDATA/Code - Insiders/User/snippets"
    ],
    "Target.Mac": [
      "~/Library/Application Support/Code/User/snippets",
      "~/Library/Application Support/Code - Insiders/User/snippets"
    ]
  },
  {
    "Source": "@/config/vscode/settings.jsonc",
    "Target.Win": [
      "$APPDATA/Code/User/settings.json",
      "$APPDATA/Code - Insiders/User/settings.json"
    ],
    "Target.Mac": [
      "~/Library/Application Support/Code/User/settings.json",
      "~/Library/Application Support/Code - Insiders/User/settings.json"
    ]
  },
  {
    "Source": "@/config/vscode/keybindings.jsonc",
    "Target.Win": [
      "$APPDATA/Code/User/keybindings.json",
      "$APPDATA/Code - Insiders/User/keybindings.json"
    ]
  },
  {
    "Source": "@/config/vscode/mac-keybindings.jsonc",
    "Target.Mac": [
      "~/Library/Application Support/Code/User/keybindings.json",
      "~/Library/Application Support/Code - Insiders/User/keybindings.json"
    ]
  }
]
