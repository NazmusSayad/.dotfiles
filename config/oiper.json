{
  "bypassHotkey": false,
  "cloudASRs": [
    {
      "id": "groq-whisper",
      "model": "whisper-large-v3",
      "provider": "groq"
    },
    {
      "id": "openrouter-whisper",
      "model": "openai/whisper-large-v3",
      "provider": "openrouter"
    },
    {
      "apiKeyEnv": "ELEVENLABS_API_KEY",
      "apiUrl": "https://api.elevenlabs.io/v1",
      "id": "elevenlabs-scribe",
      "model": "scribe_v2",
      "spec": "elevenlabs"
    }
  ],
  "cloudLLMs": [
    {
      "id": "cerebras-gpt-oss-120b",
      "model": "gpt-oss-120b",
      "provider": "cerebras"
    },
    {
      "id": "cerebras-qwen-3.8-27b",
      "model": "qwen-3.8-27b",
      "provider": "cerebras"
    },
    {
      "id": "openrouter-kimi",
      "model": "moonshotai/kimi-k2-0905:nitro",
      "provider": "openrouter"
    },
    {
      "id": "openrouter-mini",
      "model": "openai/gpt-oss-120b:nitro",
      "provider": "openrouter"
    },
    {
      "id": "openrouter-mercury-2.5",
      "model": "inception/mercury-2.5:nitro",
      "provider": "openrouter"
    },
    {
      "id": "openrouter-qwen3-vl-8b-instruct",
      "model": "qwen/qwen3-vl-8b-instruct:nitro",
      "provider": "openrouter"
    },
    {
      "id": "openrouter-nemotron-3-nano-30b-a3b",
      "model": "nvidia/nemotron-3-nano-30b-a3b:nitro",
      "provider": "openrouter"
    }
  ],
  "defaultProfile": {
    "autoSubmit.macos": "Disabled",
    "autoSubmit.windows": "Disabled",
    "enhancementLlmId": "cerebras-gpt-oss-120b",
    "hotkeyHold.macos": [
      "ShiftRight+ControlRight",
      "ShiftRight+MetaRight"
    ],
    "hotkeyHold.windows": [
      "AltGr+MetaRight"
    ],
    "hotkeyToggle.macos": [],
    "id": "default",
    "language": "en",
    "mode": "cloud",
    "name": "Default",
    "transcribeAsrId": "groq-whisper",
    "transcribeAsrModel": "parakeet:parakeet-tdt-0.6b-v3"
  },
  "enableMultipleHotkeys": true,
  "historyRetentionDays": 0,
  "injectionMethod.macos": "Ctrl+V",
  "injectionMethod.windows": "Ctrl+V",
  "localModelLoading": "on-recording-start",
  "profiles": [
    {
      "autoSubmit.macos": "Disabled",
      "autoSubmit.windows": "Disabled",
      "enhancementLlmId": "cerebras-gpt-oss-120b",
      "enhancementType": "basic",
      "hotkeyHold.macos": [
        "ShiftLeft+ControlLeft",
        "ShiftLeft+MetaLeft",
        "F15"
      ],
      "hotkeyHold.windows": [
        "ShiftLeft+ControlLeft",
        "ShiftLeft+MetaLeft",
        "F15"
      ],
      "hotkeyToggle.macos": [
        "ShiftRight+ControlLeft",
        "ShiftRight+MetaLeft"
      ],
      "hotkeyToggle.windows": [
        "ShiftRight+ControlLeft",
        "ShiftRight+MetaLeft"
      ],
      "id": "basic-profile",
      "language": "en",
      "mode": "cloud",
      "name": "English",
      "overlayStyle": "block",
      "transcribeAsrId": "groq-whisper",
      "transcribeAsrModel": "parakeet:parakeet-tdt-0.6b-v3"
    },
    {
      "autoSubmit.macos": "Disabled",
      "autoSubmit.windows": "Disabled",
      "enhancementLlmId": "openrouter-kimi",
      "hotkeyHold.macos": [
        "ShiftLeft+Alt",
        "ShiftLeft+F15"
      ],
      "hotkeyHold.windows": [
        "ShiftLeft+Alt",
        "ShiftLeft+F15"
      ],
      "hotkeyToggle.macos": [
        "ShiftRight+Alt"
      ],
      "hotkeyToggle.windows": [
        "ShiftRight+Alt"
      ],
      "id": "prompt-profile",
      "language": "bn",
      "mode": "cloud",
      "name": "Bangla",
      "overlayShowName": true,
      "overlayStyle": "bars",
      "transcribeAsrId": "elevenlabs-scribe",
      "transcribeAsrModel": "parakeet:parakeet-tdt-0.6b-v3"
    }
  ],
  "snippets": [
    {
      "body": "https://nazmussayad.com",
      "when": [
        {
          "value": "My Website"
        }
      ]
    },
    {
      "body": "https://github.com/NazmusSayad",
      "when": [
        {
          "value": "My GitHub"
        }
      ]
    },
    {
      "body": "https://t.me/NazmusSayad",
      "when": [
        {
          "value": "My Telegram"
        }
      ]
    },
    {
      "body": "https://x.com/NazmusSayadX",
      "when": [
        {
          "value": "My Twitter"
        }
      ]
    },
    {
      "body": "https://fb.com/NazmusSayad",
      "when": [
        {
          "value": "My Facebook"
        }
      ]
    },
    {
      "body": "https://instagram.com/NazmusSayad",
      "when": [
        {
          "value": "My Instagram"
        }
      ]
    },
    {
      "body": "https://github.com/NazmusSayad/.dotfiles",
      "when": [
        {
          "value": "My .files"
        }
      ]
    },
    {
      "body": "https://oiper.com",
      "when": [
        {
          "value": "OiPer Website"
        }
      ]
    },
    {
      "body": "https://github.com/OiPer/desktop",
      "when": [
        {
          "value": "OiPer Desktop GitHub"
        }
      ]
    }
  ],
  "soundEffects": {
    "emptyAudio": true,
    "fail": true,
    "startRecording": false,
    "stopRecording": false
  },
  "whisperBackend.macos": "auto",
  "whisperBackend.windows": "auto",
  "words": [
    "NazmusSayad",
    "OiPer",
    "Claude"
  ],
  "writeClipboard": false
}