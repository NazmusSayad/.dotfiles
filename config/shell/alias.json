{
  "oc": "opencode --standalone",
  "occ": "opencode --standalone --continue",

  "cc": "claude",
  "ccr": "claude --resume",
  "ccc": "claude --continue",

  "ec": "CLAUDE_CONFIG_DIR=~/.claude-extra claude",
  "ecr": "CLAUDE_CONFIG_DIR=~/.claude-extra claude --resume",
  "ecc": "CLAUDE_CONFIG_DIR=~/.claude-extra claude --continue",

  "ag": "antigravity --dangerously-skip-permissions",
  "agc": "antigravity --dangerously-skip-permissions --continue",

  "r": "nr",
  "nid": "ni -D",
  "pab": "pnpm approve-builds --all",
  "naa": "npm install-scripts approve --all",

  "gy": "gityo",
  "gyy": "gityo --yolo",
  "ghp": "gityo pr create",
  "ghm": "gityo pr merge",
  "ghr": "gityo release",

  "m": "make",
  "j": "just",

  "c": "code",
  "ci": "code-insiders",

  "gz": "lazygit",
  "mgit": "manygit",

  "gc": "git checkout",
  "gcn": "git checkout -b",
  "gpa": "git push --all",

  "ghv": "gh repo view",
  "ghw": "gh repo view --web",

  "dz": "lazydocker",
  "dc": "docker compose",
  "dcu": "docker compose up -d",
  "dcd": "docker compose down",
  "dcr": "docker compose restart",

  "ex": { "cmd": "explorer", "platform": "windows" },
  "where": { "cmd": "which -a", "platform": "macos" },

  "fix-next": "rm -rf .next",
  "fix-ports": { "cmd": "sudo net stop winnat", "platform": "windows" },

  "claude-link": "rm -f ./CLAUDE.md && ln -s ./AGENTS.md ./CLAUDE.md",
  "claude-skills": "mkdir -p ./.claude && rm -rf ./.claude/skills && ln -s ../.agents/skills ./.claude/skills",
  "claude-chrome": "claude mcp add --scope project chrome-devtools -- chrome-devtools-mcp --viewport-size=1440x900 --headless --isolated",
  "claude-playwright": "claude mcp add --scope project playwright -- playwright-mcp --viewport-size=1440x900 --headless --isolated",

  "q": { "cmd": "clear", "cmd.pwsh": "Clear-Host" },
  "qq": { "cmd": "exit", "cmd.pwsh": "exit" },

  "lsf": "ls -f",
  "rmf": "rm -rf",

  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  ".....": "cd ../../../..",

  "health-open": "node ~/.health/dist/index.mjs open",
  "health-collect": "node ~/.health/dist/index.mjs collect"
}
