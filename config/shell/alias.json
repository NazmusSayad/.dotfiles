{
  "oc": "opencode",
  "occ": "opencode --continue",

  "cc": "claude",
  "ccr": "claude --resume",
  "ccc": "claude --continue",

  "wc": "CLAUDE_CONFIG_DIR=~/.claude-wmb claude",
  "wcr": "CLAUDE_CONFIG_DIR=~/.claude-wmb claude --resume",
  "wcc": "CLAUDE_CONFIG_DIR=~/.claude-wmb claude --continue",

  "ag": "antigravity --dangerously-skip-permissions",
  "agc": "antigravity --dangerously-skip-permissions --continue",

  "r": "nr",
  "nid": "ni -D",
  "pab": "pnpm approve-builds --all",

  "gy": "gityo",
  "gyy": "gityo --yolo",

  "m": "make",
  "j": "just",

  "c": "code",
  "c.": "code .",
  "ci": "code-insiders",
  "ci.": "code-insiders .",

  "gz": "lazygit",
  "mgit": "monogit",
  "gc": "git checkout",
  "gcn": "git checkout -b",

  "ghv": "gh repo view",
  "ghw": "gh repo view --web",

  "dz": "lazydocker",
  "dc": "docker compose",
  "dcu": "docker compose up -d",
  "dcd": "docker compose down",
  "dcr": "docker compose restart",

  "ex": { "cmd": "explorer", "platform": "windows" },
  "where": { "cmd": "which -a", "platform": "macos" },

  "fix-next": "rm -rf .next",
  "fix-ports": { "cmd": "sudo net stop winnat", "platform": "windows" },

  "claude-link": "rm -f ./CLAUDE.md && ln -s ./AGENTS.md ./CLAUDE.md",
  "claude-gc": "claude mcp add --scope project chrome-devtools -- chrome-devtools-mcp --viewport-size=1440x900 --headless --isolated",
  "claude-pw": "claude mcp add --scope project playwright -- playwright-mcp --viewport-size=1440x900 --headless --isolated",

  "q": "clear",
  "qq": "exit",
  "lsf": "ls -f",
  "rmf": "rm -rf",

  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  ".....": "cd ../../../.."
}
