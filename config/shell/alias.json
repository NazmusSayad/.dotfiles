{
  "oc": "opencode",
  "occ": "opencode --continue",

  "cc": "claude",
  "ccr": "claude --resume",
  "ccc": "claude --continue",

  "uc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude",
  "ucr": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --resume",
  "ucc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --continue",

  "wc": "CLAUDE_CONFIG_DIR=~/.claude-work claude",
  "wcr": "CLAUDE_CONFIG_DIR=~/.claude-work claude --resume",
  "wcc": "CLAUDE_CONFIG_DIR=~/.claude-work claude --continue",

  "ic": "CLAUDE_CONFIG_DIR=~/.claude-imam claude",
  "icr": "CLAUDE_CONFIG_DIR=~/.claude-imam claude --resume",
  "icc": "CLAUDE_CONFIG_DIR=~/.claude-imam claude --continue",

  "ag": "antigravity --dangerously-skip-permissions",
  "agc": "antigravity --dangerously-skip-permissions --continue",

  "r": "nr",
  "nid": "ni -D",
  "pab": "pnpm approve-builds --all",

  "gy": "gityo",
  "gyy": "gityo --yolo",

  "j": "just",
  "m": "make",

  "c": "code",
  "c.": "code .",
  "ci": "code-insiders",
  "ci.": "code-insiders .",

  "gz": "lazygit",
  "mgit": "monogit",
  "gc": "git checkout",
  "gcn": "git checkout -b",

  "ghv": "gh repo view",
  "ghw": "gh repo view --web",

  "dz": "lazydocker",
  "dc": "docker compose",
  "dcu": "docker compose up -d",
  "dcd": "docker compose down",
  "dcr": "docker compose restart",

  "lsf": "ls -f",
  "rmf": "rm -rf",

  "xxx": "exit",
  "x": { "cmd": "clear", "cmd.pwsh": "Clear-Host" },

  "ex": { "cmd": "explorer", "platform": "windows" },
  "where": { "cmd": "which -a", "platform": "macos" },

  "fix-claude.md": "rm -f ./CLAUDE.md && ln -s ./AGENTS.md ./CLAUDE.md",

  "fix-next": "rm -rf .next",
  "fix-ports": {
    "cmd": "sudo net stop winnat",
    "platform": "windows"
  },

  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  ".....": "cd ../../../.."
}
