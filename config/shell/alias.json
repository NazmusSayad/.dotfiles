{
  "oc": "opencode",
  "occ": "opencode --continue",

  "co": "codex --dangerously-bypass-approvals-and-sandbox",
  "coc": "codex resume --dangerously-bypass-approvals-and-sandbox --last",
  "cor": "codex resume --dangerously-bypass-approvals-and-sandbox",

  "so": "CODEX_HOME=~/.codex-sayad codex --dangerously-bypass-approvals-and-sandbox",
  "soc": "CODEX_HOME=~/.codex-sayad codex resume --dangerously-bypass-approvals-and-sandbox --last",
  "sor": "CODEX_HOME=~/.codex-sayad codex resume --dangerously-bypass-approvals-and-sandbox",

  "cc": "claude",
  "ccr": "claude --resume",
  "ccc": "claude --continue",
  "cc4": "claude --model claude-opus-4-8",
  "ccr4": "claude --model claude-opus-4-8 --resume",
  "ccc4": "claude --model claude-opus-4-8 --continue",

  "uc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude",
  "ucr": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --resume",
  "ucc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --continue",
  "uc4": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --model claude-opus-4-8",
  "ucr4": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --model claude-opus-4-8 --resume",
  "ucc4": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --model claude-opus-4-8 --continue",

  "wc": "CLAUDE_CONFIG_DIR=~/.claude-work claude",
  "wcr": "CLAUDE_CONFIG_DIR=~/.claude-work claude --resume",
  "wcc": "CLAUDE_CONFIG_DIR=~/.claude-work claude --continue",
  "wc4": "CLAUDE_CONFIG_DIR=~/.claude-work claude --model claude-opus-4-8",
  "wcr4": "CLAUDE_CONFIG_DIR=~/.claude-work claude --model claude-opus-4-8 --resume",
  "wcc4": "CLAUDE_CONFIG_DIR=~/.claude-work claude --model claude-opus-4-8 --continue",

  "sc": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --effort medium",
  "scr": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --resume --effort medium",
  "scc": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --continue --effort medium",
  "sc4": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --model claude-opus-4-8 --effort medium",
  "scr4": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --model claude-opus-4-8 --resume --effort medium",
  "scc4": "CLAUDE_CONFIG_DIR=~/.claude-sayad claude --model claude-opus-4-8 --continue --effort medium",

  "ag": "antigravity --dangerously-skip-permissions",
  "agc": "antigravity --dangerously-skip-permissions --continue",

  "ocs": {
    "cmd": "opencode-server stop",
    "platform": "windows"
  },
  "ocrs": {
    "cmd": "opencode-server stop; powershell -Command \"Start-Process opencode-server -WindowStyle Hidden\"",
    "platform": "windows"
  },

  "r": "nr",
  "nid": "ni -D",
  "pab": "pnpm approve-builds --all",

  "gy": "gityo",
  "gyy": "gityo --yolo",

  "j": "just",
  "m": "make",

  "c": "code",
  "c.": "code .",
  "ci": "code-insiders",
  "ci.": "code-insiders .",

  "gz": "lazygit",
  "mgit": "monogit",
  "gc": "git checkout",
  "gcn": "git checkout -b",

  "ghv": "gh repo view",
  "ghw": "gh repo view --web",

  "dz": "lazydocker",
  "dc": "docker compose",
  "dcu": "docker compose up -d",
  "dcd": "docker compose down",
  "dcr": "docker compose restart",

  "lsf": "ls -f",
  "rmf": "rm -rf",

  "ex": { "cmd": "explorer", "platform": "windows" },
  "where": { "cmd": "command -a", "platform": "macos" },

  "fix-next": "rm -rf .next",
  "fix-ports": {
    "cmd": "sudo net stop winnat",
    "platform": "windows"
  },

  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  ".....": "cd ../../../.."
}
