{
  "oc": "opencode",
  "occ": "opencode --continue",

  "co": "codex",
  "coc": "codex resume --last",
  "cor": "codex resume",

  "so": "CODEX_HOME=~/.codex-sayad codex",
  "soc": "CODEX_HOME=~/.codex-sayad codex resume --last",
  "sor": "CODEX_HOME=~/.codex-sayad codex resume",

  "cc": "claude",
  "ccc": "claude --continue",
  "ccr": "claude --resume",

  "uc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude",
  "ucc": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --continue",
  "ucr": "CLAUDE_CONFIG_DIR=~/.claude-uig claude --resume",

  "wc": "CLAUDE_CONFIG_DIR=~/.claude-work claude",
  "wcc": "CLAUDE_CONFIG_DIR=~/.claude-work claude --continue",
  "wcr": "CLAUDE_CONFIG_DIR=~/.claude-work claude --resume",

  "ocs": {
    "cmd": "opencode-server stop",
    "platform": "windows"
  },
  "ocrs": {
    "cmd": "opencode-server stop; powershell -Command \"Start-Process opencode-server -WindowStyle Hidden\"",
    "platform": "windows"
  },

  "r": "nr",
  "nid": "ni -D",
  "pab": "pnpm approve-builds --all",

  "gy": "gityo",
  "gyy": "gityo --yolo",

  "j": "just",
  "m": "make",

  "gz": "lazygit",
  "mgit": "monogit",
  "gc": "git checkout",
  "gcn": "git checkout -b",

  "ghv": "gh repo view",
  "ghw": "gh repo view --web",

  "dz": "lazydocker",
  "dc": "docker compose",
  "dcu": "docker compose up -d",
  "dcd": "docker compose down",
  "dcr": "docker compose restart",

  "lsf": "ls -f",
  "rmf": "rm -rf",

  "ex": {
    "cmd": "explorer",
    "platform": "windows"
  },
  "where": {
    "cmd": "command -a",
    "platform": "macos"
  },
  "fix-ports": {
    "cmd": "sudo net stop winnat",
    "platform": "windows"
  },
  "fix-next": "rm -rf .next",

  "c": "clear",
  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  ".....": "cd ../../../.."
}
