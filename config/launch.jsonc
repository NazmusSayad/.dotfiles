[
  {
    "Path": "ctfmon.exe",
    "AsAdmin": true,
    "Wait": true
  },
  {
    "Path": "cmd.exe",
    "Args": ["/c"],
    "AsAdmin": true,
    "Wait": true
  },
  {
    "Path": "@/.local/bin.win/windows-env.exe",
    "Wait": true
  },
  {
    "Path": "gpg",
    "Args": ["--list-keys"],
    "AsAdmin": true
  },

  {
    "Path": "~/scoop/apps/sharex/current/ShareX.exe",
    "AsAdmin": true
  },

  {
    "Path": "@/.local/ahk/AHK-Macro.exe",
    "AsAdmin": true
  },
  {
    "Path": "@/.local/ahk/AHK-ScrollWheel.exe",
    "AsAdmin": true
  },
  {
    "Path": "@/.local/ahk/AHK-WindowManager.exe",
    "AsAdmin": true
  },
  {
    "Path": "@/.local/ahk/AHK-VirtualDesktop-W11.exe",
    "AsAdmin": true
  },

  {
    "Path": "clean-code-snippets",
    "AsUser": true
  },
  {
    "Path": "powershell.exe",
    "Args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$DOTFILES_DIR\\config\\wsl\\start.ps1"
    ],
    "AsUser": true
  }
]
