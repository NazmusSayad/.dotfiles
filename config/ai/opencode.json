{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "autoshare": false,
  "share": "disabled",

  "permission": {
    "*": "allow",
    "lsp": "deny",
    "doom_loop": "deny"
  },

  "lsp": false,
  "snapshot": false,

  "shell": "{env:OPENCODE_SHELL}",
  "plugin": ["opencode-ext", "opencode-wakatime"],

  "mcp": {
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--viewport=1440x900x1",
        "--headless",
        "--isolated"
      ]
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "playwright-mcp",
        "--viewport-size=1440x900",
        "--headless",
        "--isolated"
      ]
    }
  },

  "agent": {
    "build": { "color": "#C18A57" },
    "explore": {
      "color": "#ABB2BF",
      "permission": { "edit": "deny", "question": "deny", "task": "deny" },
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "general": {
      "color": "#D46870",
      "permission": { "question": "deny", "task": "deny" }
    },
    "plan": { "color": "#43ACB9", "permission": { "edit": "deny" } },
    "title": {
      "model": "cerebras/gpt-oss-120b"
    }
  },

  "enabled_providers": ["cerebras", "openai", "opencode-go", "openrouter"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "attachment": true,
          "cost": { "cache_read": 0.02, "input": 0.2, "output": 1.2 },
          "family": "gpt-luna",
          "id": "gpt-5.6-luna",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        },
        "gpt-5.6-sol": {
          "attachment": true,
          "cost": { "cache_read": 0.4, "input": 4, "output": 20 },
          "family": "gpt-sol",
          "id": "gpt-5.6-sol",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        },
        "gpt-5.6-terra": {
          "attachment": true,
          "cost": { "cache_read": 0.2, "input": 2, "output": 12 },
          "family": "gpt-terra",
          "id": "gpt-5.6-terra",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        },
        "gpt-6-astra": {
          "attachment": true,
          "cost": { "cache_read": 1, "input": 10, "output": 50 },
          "family": "gpt-astra",
          "id": "gpt-6-astra",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-6 Astra",
          "reasoning": true,
          "release_date": "2026-09-04",
          "temperature": false,
          "tool_call": true
        }
      },
      "whitelist": [
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-6-astra"
      ]
    },
    "opencode-go": {
      "whitelist": ["deepseek-v4.1-flash", "glm-5.3-flash"],
      "models": {
        "deepseek-v4.1-flash": {
          "attachment": true,
          "cost": { "cache_read": 0.003, "input": 0.15, "output": 0.6 },
          "family": "deepseek-flash",
          "id": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 200000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "release_date": "2026-09-10",
          "temperature": true,
          "tool_call": true
        },
        "glm-5.3-flash": {
          "attachment": true,
          "cost": { "cache_read": 0.03, "input": 0.15, "output": 0.5 },
          "family": "glm-flash",
          "id": "glm-5.3-flash",
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "video", "pdf"],
            "output": ["text"]
          },
          "name": "GLM-5.3-Flash",
          "reasoning": true,
          "release_date": "2026-08-26",
          "temperature": true,
          "tool_call": true
        }
      }
    },
    "cerebras": { "whitelist": ["gpt-oss-120b"] },
    "openrouter": {
      "whitelist": []
    }
  }
}
