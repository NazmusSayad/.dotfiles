{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "autoshare": false,
  "share": "disabled",

  "permission": {
    "*": "allow",
    "lsp": "deny",
    "doom_loop": "deny"
  },

  "lsp": false,
  "snapshot": false,

  "shell": "{env:OPENCODE_SHELL}",
  "plugin": ["opencode-ext", "opencode-wakatime"],

  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "chrome-devtools-mcp",
        "--viewport=1440x900x1",
        "--headless=true"
      ]
    }
  },

  "agent": {
    "build": { "color": "#C18A57" },
    "explore": {
      "color": "#ABB2BF",
      "permission": { "edit": "deny", "question": "deny", "task": "deny" }
    },
    "general": {
      "color": "#D46870",
      "permission": { "question": "deny", "task": "deny" }
    },
    "plan": { "color": "#43ACB9", "permission": { "edit": "deny" } },
    "title": {
      "model": "openrouter/openai/gpt-oss-120b",
      "options": {
        "provider": { "sort": "throughput" },
        "reasoning": { "effort": "medium" }
      }
    }
  },

  "enabled_providers": ["openai", "opencode-go", "openrouter"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "attachment": true,
          "cost": { "cache_read": 0.02, "input": 0.2, "output": 1.2 },
          "family": "gpt-luna",
          "id": "gpt-5.6-luna",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        },
        "gpt-5.6-sol": {
          "attachment": true,
          "cost": { "cache_read": 0.4, "input": 4, "output": 20 },
          "family": "gpt-sol",
          "id": "gpt-5.6-sol",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        },
        "gpt-5.6-terra": {
          "attachment": true,
          "cost": { "cache_read": 0.2, "input": 2, "output": 12 },
          "family": "gpt-terra",
          "id": "gpt-5.6-terra",
          "limit": { "context": 258000, "input": 258000, "output": 128000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "release_date": "2026-07-09",
          "temperature": false,
          "tool_call": true
        }
      },
      "whitelist": ["gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-terra"]
    },
    "openrouter": {
      "whitelist": ["openai/gpt-oss-120b"]
    },
    "opencode-go": { "whitelist": ["glm-5.3-flash"] }
  }
}
