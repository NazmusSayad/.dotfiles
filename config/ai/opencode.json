{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "autoshare": false,
  "share": "disabled",

  "permission": {
    "*": "allow",
    "lsp": "deny",
    "doom_loop": "deny"
  },

  "lsp": false,
  "snapshot": false,
  "plugin": ["opencode.env", "opencode-armor", "opencode-wakatime"],

  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "chrome-devtools-mcp",
        "--viewport=1440x900x1",
        "--headless=true"
      ]
    }
  },

  "agent": {
    "build": { "color": "#C18A57" },
    "explore": {
      "color": "#ABB2BF",
      "permission": { "edit": "deny", "question": "deny", "task": "deny" }
    },
    "general": {
      "color": "#D46870",
      "permission": { "question": "deny", "task": "deny" }
    },
    "plan": { "color": "#43ACB9", "permission": { "edit": "deny" } },
    "title": {
      "model": "openrouter/openai/gpt-oss-120b",
      "options": {
        "provider": { "sort": "throughput" },
        "reasoning": { "effort": "medium" }
      }
    }
  },

  "enabled_providers": ["opencode", "openrouter"],
  "provider": {
    "opencode": {
      "whitelist": ["deepseek-v4-flash-free", "mimo-v2.5-free"]
    },
    "openrouter": { "whitelist": ["openai/gpt-oss-120b"] }
  }
}
