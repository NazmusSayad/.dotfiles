{
  "$schema": "https://github.com/NazmusSayad/opencode-ext/raw/refs/heads/schema/schema.json",

  "armor": {
    "blacklist": {
      "commands": ["go build", "colima"]
    }
  },

  "agents": {
    "explore": [
      {
        "when": {
          "provider": "openai",
          "model": "gpt-5.6-sol"
        },

        "use": {
          "provider": "openai",
          "model": "gpt-5.6-terra"
        }
      }
    ]
  }
}
