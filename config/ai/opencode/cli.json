{
  "theme": { "name": "one-eye-care", "mode": "dark" },
  "mouse": true,
  "cursor": { "style": "line", "blinking": true },
  "scroll": { "speed": 0.001, "acceleration": true },
  "attention": {
    "notifications": true,
    "sound": true,
    "sounds": { "subagent_done": "./sounds/silent.mp3" }
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "tps": false,
    "new_location": "inherit",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  },
  "diffs": {
    "view": "split"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  }
}
